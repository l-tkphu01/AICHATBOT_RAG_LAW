# AI CHATBOT RAG - ENV TEMPLATE
# Copy file này thành .env rồi điền giá trị thật cho môi trường của bạn.

# Runtime API keys
GROQ_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=

# Database
POSTGRES_USER=chatbot_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=chatbot_rag
DATABASE_URL=postgresql+asyncpg://chatbot_user:change_me@postgres:5432/chatbot_rag

# Vector store
CHROMA_PERSIST_DIR=./vectorstore
CHROMA_COLLECTION_NAME=legal_documents

# Models / Retrieval
EMBEDDING_MODEL=embed-multilingual-v3.0
EMBEDDING_DIMENSION=1024
LLM_MODEL=google/gemini-2.5-flash-lite
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RELEVANCE_THRESHOLD=0.3

# Cache / Server
REDIS_URL=redis://redis:6379/0
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Optional tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=chatbot-rag-legal
